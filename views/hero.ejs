<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Post Maker</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 text-gray-800">

  <!-- Navbar -->
  <nav class="bg-white shadow-md p-4 flex justify-between items-center">
    <h1 class="text-xl font-bold text-blue-500">Postify</h1>
    
    <div class="space-x-4">
      <a href="/login" class="text-gray-700 hover:text-blue-500">Login</a>
      <a href="/register" class="bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition">
        Get Started
      </a>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="flex flex-col items-center justify-center text-center h-[85vh] px-6">
    
    <!-- Card -->
    <div class="bg-white p-10 rounded-xl shadow-md max-w-2xl">

      <h2 class="text-4xl md:text-5xl font-bold mb-4">
        Create & Share Posts
      </h2>

      <h3 class="text-blue-500 text-2xl font-semibold mb-4">
        Effortlessly
      </h3>

      <p class="text-gray-600 mb-6">
        Build, customize, and publish your posts in seconds.
        Express your ideas, share updates, and connect with others — all in one place.
      </p>

      <!-- Buttons -->
      <div class="space-x-4">
        <a href="/register"
          class="bg-blue-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-600 transition">
          Start Creating
        </a>

        <a href="/explore"
          class="border border-gray-300 px-6 py-3 rounded-lg hover:bg-gray-100 transition">
          Explore Posts
        </a>
      </div>

    </div>

  </section>

</body>
</html>