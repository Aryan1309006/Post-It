<!-- prettier-ignore-start -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Post_It</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">

  <!-- Navbar -->
  <nav class="bg-white shadow-md p-4 flex justify-between items-center">
    <div class="flex space-x-6">
      <a href="#" class="text-blue-600 font-semibold">Profile</a>
      <a href="#" class="text-gray-700 hover:text-blue-600">Explore</a>
    </div>
    <a href="/logout">
    <button class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600">
      Logout
    </button></a>
  </nav>

  <!-- Main Container -->
  <div class="max-w-2xl mx-auto mt-8">

    <!-- Welcome -->
  
    <h1 class="text-2xl font-bold mb-4">Hello <span class="text-bold text-cyan-400 text-4xl"> <%= user.name %>👋🏼</span></h1>
    <p class="text-gray-600 mb-6">
      Welcome to your profile! Share your thoughts with the world.
    </p>

    <!-- Post Form -->
    <div class="bg-white p-4 rounded shadow-md mb-6">
      <form method="post" action="/post">
        <textarea 
          name="content"
          placeholder="Write your post..."
          class="w-full border p-3 rounded mb-3 focus:outline-none focus:ring-2 focus:ring-blue-400"
          rows="3"
        ></textarea>

        <button 
          type="submit"
          class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600"
        >
          Submit Post
        </button>
      </form>
    </div>

    <!-- Posts Section -->
    <div class="space-y-4">

      <!-- Post 1 -->
   
       <% user.posts.reverse().forEach(post => { %>
         <div class="bg-white p-4 rounded shadow-md">
        <div ><div class="text-cyan-400 text-[20px] text-bold">@<%= user.name %></div>
        <div class="text-gray-500 text-[15px]"><%= new Date(post.date).toLocaleString() %></div></div>
        <p class="mb-3">
  <%= post.content || "No content" %>
</p>
        <div class="flex space-x-4">
          <button class="bg-green-500 text-white px-3 py-1 rounded hover:bg-green-600">
            <a href="/like/<%= post._id  %>">
              <small><%=post.likes.length%></small>
              👍 Like
            </a>
          </button>
          <button class="bg-yellow-500 text-white px-3 py-1 rounded hover:bg-yellow-600">
            ✏️ Edit
          </button>
        </div>
      </div>
      <% }) %>
     

      <!-- Post 2 -->
   

    </div>

  </div>

</body>
</html>
<!-- prettier-ignore-end -->